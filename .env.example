UPSTAGE_API_KEY=your_upstage_api_key_here
MODUSIGN_TEMPLATE_ID=your_modusign_template_id_here
MODUSIGN_AUTH_HEADER=Bearer your_modusign_access_token_here
# 또는 API KEY Basic 인증을 쓸 경우 이메일:API_KEY를 넣으면 서버가 base64로 변환합니다.
# MODUSIGN_BASIC_AUTH=your_email@example.com:your_modusign_api_key
MODUSIGN_PARTICIPANT_ROLE=여행객
MODUSIGN_FIELD_MAPPING_TARGET=participant
MODUSIGN_FIELD_ANALYSIS_SUMMARY=분석요약
MODUSIGN_FIELD_SOURCE_URL=예약URL
MODUSIGN_FIELD_SOURCE_TITLE=예약출처
MODUSIGN_FIELD_CHECKED_CARDS=확인카드
MODUSIGN_FIELD_CONFIRMED_AT=확인시각
